### BEGIN INIT INFO
# Provides:          oxad
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: OFELIA OXA Daemon
# Description:       OFELIA OXA Daemon
### END INIT INFO

. /lib/lsb/init-functions

NAME=oxad
PIDFILE="/var/run/oxad.pid"

# OXA specific
PYTHON="/usr/bin/python"
AGENT="/opt/ofelia/oxa/bin/OfeliaAgent.py"
DIR="/opt/ofelia/oxa/bin/"

# Arguments for oxad
ARGS=" -b > /dev/null 2>&1 &"


# Exit if Python or daemon not found
test -x $PYTHON || exit 5
test -x $AGENT  || exit 5

case $1 in

    start)
        if [ -e $PIDFILE ]; then
            pidofproc -p $PIDFILE $PYTHON $AGENT && status="0" || status="$?"
            if [ $status = "0" ]; then
                log_success_msg "$NAME is already running"
                exit # Exit
            fi
        fi
        
        # Start the daemon
        cd $DIR
        if start_daemon -p $PIDFILE $PYTHON $AGENT $ARGS; then
            if [ ! -e $PIDFILE ]; then
                pidofproc $PYTHON $AGENT > $PIDFILE
            fi
            log_success_msg "Starting $NAME"
        else
            log_failure_msg "Failed to start $NAME"
        fi
    ;;
  
    stop)
        if [ -e $PIDFILE ]; then
            pidofproc -p $PIDFILE $PYTHON $AGENT > /dev/null && status="0" || status="$?"
            if [ "$status" = 0 ]; then
                killproc -p $PIDFILE $PYTHON $AGENT
               /bin/rm -f $PIDFILE
               log_success_msg "Stoppping $NAME"
            fi
        else
            log_warning_msg "$NAME is not running"
        fi
    ;;
  
    restart)
        $0 stop && sleep 2 && $0 start
    ;;
  
    status)
        if [ -e $PIDFILE ]; then
            pidofproc -p $PIDFILE $PYTHON $AGENT > /dev/null && log_success_msg "$NAME is running" && exit 0 || exit $?
        else
            log_warning_msg "$NAME is not running"
        fi
    ;;
  
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 2
    ;;
    
    
esac
